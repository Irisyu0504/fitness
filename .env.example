# MySQL
MYSQL_ROOT_PASSWORD=你的数据库密码
MYSQL_DATABASE=fitness

# Spring Boot 后端
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/fitness?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=你的数据库密码（和MYSQL_ROOT_PASSWORD一样）
JWT_SECRET=你的JWT密钥（随便一个长字符串）
DEEPSEEK_API_KEY=你的DeepSeek API Key
